# Set these as Vercel Environment Variables. Never commit real values.
PUBLIC_SITE_URL=https://your-domain.example
TELEGRAM_BOT_USERNAME=your_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
XUI_ACCESS_URL=https://panel.example/path/
XUI_API_TOKEN=
FREE_ADMIN_SECRET=
# The Vercel Upstash integration injects KV_REST_API_URL and KV_REST_API_TOKEN.
# Do not add them manually when they already appear in Project Environment Variables.
# Without that integration, set this alternative pair instead:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
