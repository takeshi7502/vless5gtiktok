{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/top",
      "destination": "/top.html"
    },
    {
      "source": "/free",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "routes": [
    { "src": "/lib/.*", "status": 404 },
    { "src": "/test/.*", "status": 404 },
    { "src": "/FREE_WEB\\.md", "status": 404 }
  ],
  "headers": [
    {
      "source": "/(free|admin|top)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(free|admin|top).html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
