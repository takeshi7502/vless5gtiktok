{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/free",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "crons": [
    {
      "path": "/api/free/usage-alerts",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "api/free/usage-alerts.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/lib/.*", "status": 404 },
    { "src": "/test/.*", "status": 404 },
    { "src": "/FREE_WEB\\.md", "status": 404 }
  ],
  "headers": [
    {
      "source": "/(free|admin)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(free|admin).html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
