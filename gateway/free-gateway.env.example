# Source details and values below are only examples. Do not commit real Redis tokens.
# The gateway accepts UPSTASH_REDIS_REST_* or the KV_REST_API_* pair shown in Upstash.
KV_REST_API_URL=https://your-redis.upstash.io
KV_REST_API_TOKEN=replace-me

# Must match the Vercel project's free-store prefix unless you intentionally use a new store.
GATEWAY_REDIS_KEY_PREFIX=free-web:v1
GATEWAY_TOKEN_PATH_PREFIX=/f/
GATEWAY_MAX_ACTIVE_IPS=2
GATEWAY_LEASE_SECONDS=90
GATEWAY_REFRESH_SECONDS=20
GATEWAY_HANDSHAKE_RPM=60

# The gateway owns the public listener; Xray must listen only on this local backend.
LISTEN_ADDR=:443
BACKEND_URL=http://127.0.0.1:10001
BACKEND_PATH=/vless

# Leave empty for plain HTTP behind a trusted reverse proxy/CDN.
# TLS_CERT_FILE=/etc/free-gateway/tls/fullchain.pem
# TLS_KEY_FILE=/etc/free-gateway/tls/privkey.pem

# Never trust forwarding headers unless direct public access is blocked and these CIDRs
# are the only proxies permitted to reach this listener.
# TRUSTED_PROXY_CIDRS=173.245.48.0/20,103.21.244.0/22
# CLIENT_IP_HEADER=CF-Connecting-IP
