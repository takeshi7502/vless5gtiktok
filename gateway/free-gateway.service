[Unit]
Description=Free WebSocket admission gateway
Documentation=https://github.com/takeshi7502/vless5gtiktok/tree/main/gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=free-gateway
Group=free-gateway
EnvironmentFile=/etc/free-gateway/free-gateway.env
ExecStart=/usr/local/bin/free-gateway
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/free-gateway
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
